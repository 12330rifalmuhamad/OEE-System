    {
      "id": "initiate_okp_payload",
      "type": "function",
      "z": "oee_sim_tab",
      "name": "Set OKP Payload",
      "func": "const today = new Date();\nconst okpNum = \"OKP-RED-\" + today.getFullYear() + String(today.getMonth() + 1).padStart(2, '0') + String(today.getDate()).padStart(2, '0') + \"-\" + Math.floor(Math.random() * 1000);\nmsg.payload = {\n    okpNumber: okpNum,\n    machineName: \"Filling Line A4\",\n    shift: 1,\n    loadingTime: 480\n};\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\nreturn msg;",
      "outputs": 1,
      "noerr": 0,
      "initialize": "",
      "finalize": "",
      "libs": [],
      "x": 410,
      "y": 40,
      "wires": [
        [
          "initiate_okp_http"
        ]
      ]
    },
    {
      "id": "initiate_okp_http",
      "type": "http request",
      "z": "oee_sim_tab",
      "name": "POST /api/transactions/okp/initiate",
      "method": "POST",
      "ret": "obj",
      "url": "http://localhost:5001/api/transactions/okp/initiate",
      "encrypt": false,
      "tls": "",
      "persist": false,
      "proxy": "",
      "insecureHTTPParser": false,
      "authType": "",
      "senderr": false,
      "headers": [],
