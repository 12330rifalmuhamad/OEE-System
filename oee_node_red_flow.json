      "func": "let currentStatus = flow.get('m4_status') !== undefined ? flow.get('m4_status') : 1;\n// 10% chance to toggle state\nif (Math.random() < 0.10) {\n    currentStatus = currentStatus === 1 ? 0 : 1;\n}\nflow.set('m4_status', currentStatus);\nmsg.payload = currentStatus;\nreturn msg;",
