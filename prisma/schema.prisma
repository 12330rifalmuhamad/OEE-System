// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. DATA PLATFORM UTAMA (MULTI-TENANT)
model Company {
  id             Int       @id @default(autoincrement()) @map("intCompany_ID")
  name           String    @map("txtCompanyName")    // Nama Pabrik / Perusahaan
  subscription   String    @map("txtSubscription")    // Misal: "FREE", "PRO", "ENTERPRISE"
  
  // Relasi: Satu perusahaan memiliki banyak...
  users          User[]
  machines       Machine[]
  products       Product[]
  activityCodes  ActivityCode[]
  okpLogs        OkpLog[]
  kpiTarget      KpiTarget?
  dmsActions     DmsAction[]
  mqttConfigs    MqttConfig[]
  
  createdAt      DateTime  @default(now()) @map("dtmCreatedAt")
  updatedAt      DateTime  @updatedAt @map("dtmUpdatedAt")
  createdBy      String?   @default("SYSTEM") @map("txtCreatedBy")
  updatedBy      String?   @default("SYSTEM") @map("txtUpdatedBy")
  lineProcesses  LineProcess[]

  @@map("mCompany")
}

model User {
  id         Int      @id @default(autoincrement()) @map("intUser_ID")
  email      String   @unique @map("txtEmail")
  password   String   @map("txtPassword")
  role       String   @map("txtRole")   // Misal: "OWNER", "MANAGER", "OPERATOR"
  
  companyId  Int      @map("intCompany_ID")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("dtmCreatedAt")
  updatedAt  DateTime @updatedAt @map("dtmUpdatedAt")
  createdBy  String?  @default("SYSTEM") @map("txtCreatedBy")
  updatedBy  String?  @default("SYSTEM") @map("txtUpdatedBy")

  @@map("mUser")
}

// 2. MASTER DATA (Global untuk OEE)
model ActivityCategory {
  id          Int            @id @default(autoincrement()) @map("intActivityCategory_ID")
  code        String         @unique @map("txtCode") // "PR", "SH", "BR", "SE", "MI", "CT", "OT", "ST"
  name        String         @map("txtName")
  activities  ActivityCode[]

  createdAt  DateTime @default(now()) @map("dtmCreatedAt")
  updatedAt  DateTime @updatedAt @map("dtmUpdatedAt")
  createdBy  String?  @default("SYSTEM") @map("txtCreatedBy")
  updatedBy  String?  @default("SYSTEM") @map("txtUpdatedBy")

  @@map("mActivityCategory")
}

// 3. MASTER DATA (Spesifik per Company)
model ActivityCode {
  id              Int              @id @default(autoincrement()) @map("intActivityCode_ID")
  companyId       Int              @map("intCompany_ID") // Wajib ada untuk isolasi data
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  categoryId      Int              @map("intActivityCategory_ID")
  category        ActivityCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  code            String           @map("txtCode") // Misal: "sh.1"
  mainActivity    String?          @map("txtMainActivity") // Kategori Utama (Misal: "AM Activity")
  subActivity     String?          @map("txtSubActivity") // Sub-Kategori (Misal: "- Weekly Cleaning")
  fullDescription String           @map("txtFullDescription") // Misal: "AM activity - Weekly Cleaning"
  
  logs            ActivityLog[]

  createdAt  DateTime @default(now()) @map("dtmCreatedAt")
  updatedAt  DateTime @updatedAt @map("dtmUpdatedAt")
  createdBy  String?  @default("SYSTEM") @map("txtCreatedBy")
  updatedBy  String?  @default("SYSTEM") @map("txtUpdatedBy")

  @@map("mActivityCode")
}

model Machine {
  id             Int          @id @default(autoincrement()) @map("intMachine_ID")
  companyId      Int          @map("intCompany_ID")
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String       @map("txtMachineName")
  okpLogs        OkpLog[]
  mqttConfig     MqttConfig?
  lineProcessId  Int?         @map("intLineProcess_ID")
  lineProcess    LineProcess? @relation(fields: [lineProcessId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now()) @map("dtmCreatedAt")
  updatedAt  DateTime @updatedAt @map("dtmUpdatedAt")
  createdBy  String?  @default("SYSTEM") @map("txtCreatedBy")
  updatedBy  String?  @default("SYSTEM") @map("txtUpdatedBy")

  @@map("mMachine")
}

model Product {
  id           Int      @id @default(autoincrement()) @map("intProduct_ID")
  companyId    Int      @map("intCompany_ID")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productCode  String?  @map("txtProductCode") // Kode Produk dari ERP/Oracle
  name         String   @map("txtProductName") // Nama Produk
  size         String?  @map("txtProductSize") // Ukuran (Misal: 800gr)
  standarSpeed Float    @map("fltStandardSpeed") // pcs/menit
  okpLogs      OkpLog[]

  createdAt  DateTime @default(now()) @map("dtmCreatedAt")
  updatedAt  DateTime @updatedAt @map("dtmUpdatedAt")
  createdBy  String?  @default("SYSTEM") @map("txtCreatedBy")
  updatedBy  String?  @default("SYSTEM") @map("txtUpdatedBy")

  @@map("mProduct")
}

// 4. TRANSACTION DATA (Transaksi per Company)
model OkpLog {
  id           Int      @id @default(autoincrement()) @map("intOkpLog_ID")
  companyId    Int      @map("intCompany_ID")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  okpNumber    String   @map("txtOkpNumber") // Catatan: Kombinasi unique dengan companyId disarankan di level database
  date         DateTime @map("dtmDate")
  shift        Int      @map("intShift")
  
  machineId    Int      @map("intMachine_ID")
  machine      Machine  @relation(fields: [machineId], references: [id], onDelete: Restrict)
  productId    Int      @map("intProduct_ID")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Data Man Power
  groupLeader  String?  @map("txtGroupLeader")
  operator     String?  @map("txtOperator")
  helper       String?  @map("txtHelper")

  loadingTime  Float    @map("fltLoadingTime") // Menit
  totalOutput  Float    @map("fltTotalOutput") // (CB / Pcs)
  rework       Float    @map("fltRework") // (Kg / Pcs)
  reject       Float    @map("fltReject") // (Kg / Pcs)
  sampleQc     Float?   @map("fltSampleQc") // (FB)

  // Physical OEE calculation columns
  availability Float?   @map("decAvailability")
  performance  Float?   @map("decPerformance")
  quality      Float?   @map("decQuality")
  oee          Float?   @map("decOEE")
  downtime     Float?   @map("decDowntime")
  mi           Float?   @map("decMI")

  activities   ActivityLog[]
  dmsActions   DmsAction[]
  
  createdAt    DateTime @default(now()) @map("dtmCreatedAt")
  updatedAt    DateTime @updatedAt @map("dtmUpdatedAt")
  createdBy    String?  @default("SYSTEM") @map("txtCreatedBy")
  updatedBy    String?  @default("SYSTEM") @map("txtUpdatedBy")

  @@unique([companyId, okpNumber]) // Satu OKP Number harus unik di dalam satu Company
  @@map("trOkpLog")
}

model ActivityLog {
  id             Int          @id @default(autoincrement()) @map("intActivityLog_ID")
  
  okpLogId       Int          @map("intOkpLog_ID")
  okpLog         OkpLog       @relation(fields: [okpLogId], references: [id], onDelete: Cascade)
  
  activityCodeId Int          @map("intActivityCode_ID")
  activityCode   ActivityCode @relation(fields: [activityCodeId], references: [id], onDelete: Restrict)
  
  duration       Float        @map("fltDuration") // Dalam Menit
  startTime      DateTime?    @map("dtmStartTime") // Sensor IoT trigger Run/Stop
  endTime        DateTime?    @map("dtmEndTime")

  // Khusus Breakdown (BR) - Detail Root Cause / MTDT
  brRootCause    String?      @map("txtBrRootCause") // Enum/String: "8 Basic Competency", "4M", "AM/PM"
  brMtdtWaiting  Float?       @map("fltBrMtdtWaiting") // Menit Menunggu Teknisi
  brMtdtRepair   Float?       @map("fltBrMtdtRepair") // Menit Perbaikan
  brMtdtStartup  Float?       @map("fltBrMtdtStartup") // Menit Start Up / Trial

  createdAt  DateTime @default(now()) @map("dtmCreatedAt")
  updatedAt  DateTime @updatedAt @map("dtmUpdatedAt")
  createdBy  String?  @default("SYSTEM") @map("txtCreatedBy")
  updatedBy  String?  @default("SYSTEM") @map("txtUpdatedBy")

  @@map("trActivityLog")
}

// 5. STAGE 3 DATA (KPI TARGET & SHOPFLOOR DAILY MANAGEMENT SYSTEM)
model KpiTarget {
  id           Int      @id @default(autoincrement()) @map("intKpiTarget_ID")
  companyId    Int      @unique @map("intCompany_ID")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  oeeTarget    Float    @default(85.0) @map("fltOeeTarget")
  availTarget  Float    @default(90.0) @map("fltAvailTarget")
  perfTarget   Float    @default(95.0) @map("fltPerfTarget")
  qualTarget   Float    @default(99.0) @map("fltQualTarget")
  
  createdAt    DateTime @default(now()) @map("dtmCreatedAt")
  updatedAt    DateTime @updatedAt @map("dtmUpdatedAt")
  createdBy    String?  @default("SYSTEM") @map("txtCreatedBy")
  updatedBy    String?  @default("SYSTEM") @map("txtUpdatedBy")

  @@map("mKpiTarget")
}

model DmsAction {
  id           Int       @id @default(autoincrement()) @map("intDmsAction_ID")
  companyId    Int       @map("intCompany_ID")
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  okpLogId     Int?      @map("intOkpLog_ID")
  okpLog       OkpLog?   @relation(fields: [okpLogId], references: [id], onDelete: SetNull)
  
  downtimeCode String    @map("txtDowntimeCode") // Misal: "BR.007"
  actionPlan   String    @map("txtActionPlan") // Tindakan Perbaikan
  pic          String    @map("txtPic") // Person In Charge / Teknisi
  targetDate   DateTime? @map("dtmTargetDate")
  status       String    @default("OPEN") @map("txtStatus") // "OPEN", "IN_PROGRESS", "CLOSED"
  
  createdAt    DateTime  @default(now()) @map("dtmCreatedAt")
  updatedAt    DateTime  @updatedAt @map("dtmUpdatedAt")
  createdBy    String?   @default("SYSTEM") @map("txtCreatedBy")
  updatedBy    String?   @default("SYSTEM") @map("txtUpdatedBy")

  @@map("trDmsAction")
}

// 6. INDUSTRIAL IOT ACQUISITION CONFIGURATION (FLEXIBLE MQTT)
model MqttConfig {
  id              Int      @id @default(autoincrement()) @map("intMqttConfig_ID")
  companyId       Int      @map("intCompany_ID")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  machineId       Int      @unique @map("intMachine_ID") // 1 machine has 1 active MQTT sensor integration configuration
  machine         Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  
  brokerUrl       String   @default("mqtt://127.0.0.1:1883") @map("txtBrokerUrl")
  clientId        String?  @map("txtClientId") // Custom Client ID for MQTT Broker
  username        String?  @map("txtUsername")
  password        String?  @map("txtPassword")
  
  // Konfigurasi Sensor Counter Output (Photoeye / Proximity)
  counterTopic    String?  @map("txtCounterTopic") // Topic untuk counter output (misal: "kmi/lineA4/counter")
  counterJsonPath String?  @map("txtCounterJsonPath") // JSON Path jika payload berupa JSON Object (misal: "$.qty")
  
  // Konfigurasi Sensor Status Mesin (Run / Stop / Standby)
  statusTopic     String?  @map("txtStatusTopic") // Topic untuk status mesin (misal: "kmi/lineA4/status")
  statusJsonPath  String?  @map("txtStatusJsonPath") // JSON Path jika payload berupa JSON Object (misal: "$.state")
  statusRunValue  String   @default("RUN") @map("txtStatusRunValue") // Nilai penanda Running (misal: "1" atau "RUN")
  statusStopValue String   @default("STOP") @map("txtStatusStopValue") // Nilai penanda Stopped (misal: "0" or "STOP")
  
  createdAt       DateTime @default(now()) @map("dtmCreatedAt")
  updatedAt       DateTime @updatedAt @map("dtmUpdatedAt")
  createdBy       String?  @default("SYSTEM") @map("txtCreatedBy")
  updatedBy       String?  @default("SYSTEM") @map("txtUpdatedBy")

  @@map("mMqttConfig")
}

// 7. LINE PROCESSES (Lini Produksi grouping machines)
model LineProcess {
  id         Int       @id @default(autoincrement()) @map("intLineProcess_ID")
  companyId  Int       @map("intCompany_ID")
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String    @map("txtLineProcessName")
  machines   Machine[]
  createdAt  DateTime  @default(now()) @map("dtmCreatedAt")
  updatedAt  DateTime  @updatedAt @map("dtmUpdatedAt")
  createdBy  String?   @default("SYSTEM") @map("txtCreatedBy")
  updatedBy  String?   @default("SYSTEM") @map("txtUpdatedBy")

  @@map("mLineProcess")
}
